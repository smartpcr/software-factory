# Phase 7.7 — sample env file. Copy to forge.env and fill in your secrets.
# docker compose reads this via the api service's `env_file`. Never commit
# the populated forge.env (it's listed in .gitignore).

# -- Auth (Phase 7.6) ---------------------------------------------------------
# Empty Secret = no shared-secret check (suitable for trusted networks behind
# the reverse proxy). Set to a strong random string in production.
Forge__Auth__Mode=single-user
Forge__Auth__Secret=

# -- ADO provider (Phase 5.2) -------------------------------------------------
# Personal access token with Work Items (read/write) + Code (read/write).
Forge__Ado__OrgUrl=https://dev.azure.com/your-org
Forge__Ado__Project=YourProject
Forge__Ado__Repository=your-repo
Forge__Ado__Pat=
Forge__Ado__WebhookSecret=

# -- GitHub provider (Phase 5.3) ----------------------------------------------
# Fine-grained PAT scoped to the repo, or a classic PAT with `repo` scope.
Forge__GitHub__Repo=owner/repo
Forge__GitHub__Pat=
Forge__GitHub__WebhookSecret=

# -- Sync cadence (Phase 5.7) ------------------------------------------------
Forge__Sync__Enabled=true
Forge__Sync__IntervalSeconds=60
Forge__Sync__AutoMergeEnabled=true

# -- Human gate rules (Phase 6.9) --------------------------------------------
# Comma-separated. Add to taste; defaults are merged in by the server.
# Forge__HumanGate__BranchSubstrings__0=/security
# Forge__HumanGate__TitleSubstrings__0=[security]
