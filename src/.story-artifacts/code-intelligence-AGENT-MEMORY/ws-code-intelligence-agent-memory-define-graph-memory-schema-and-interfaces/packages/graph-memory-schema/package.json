{
  "name": "@agent-memory/graph-memory-schema",
  "version": "0.1.0",
  "description": "TypeScript interfaces and JSON Schema for the agent memory code knowledge graph",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./src/schema.json"
  },
  "files": [
    "dist",
    "src/schema.json"
  ],
  "scripts": {
    "generate:schema": "tsx scripts/generate-schema.ts",
    "prebuild": "npm run generate:schema",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
