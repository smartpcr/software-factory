<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CopilotAgentOrchestrator\CopilotAgentOrchestrator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

  <!-- Link CopilotChat/Questions prompt files as test data -->
  <ItemGroup>
    <None Include="..\CopilotChat\Questions\*.md" Link="Questions\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Exclude Reqnroll.MsTest to avoid auto-generated AssemblyInitialize conflict -->
  <ItemGroup>
    <PackageReference Update="Reqnroll.MsTest" ExcludeAssets="All" />
    <PackageReference Update="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
