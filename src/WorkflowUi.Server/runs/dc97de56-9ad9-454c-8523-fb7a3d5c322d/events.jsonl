 summary comment.\n\n---\n\n**Files saved to:** \u0060E:\\icms\\Azure_Stack_HCI\\UpdateService\\784334093\\\u0060\n\n[OUTPUT:incidentFolder] E:\\icms\\Azure_Stack_HCI\\UpdateService\\784334093\n[OUTPUT:summary.md] E:\\icms\\Azure_Stack_HCI\\UpdateService\\784334093\\summary.md (4 KB)\n[OUTPUT:discussion.md] E:\\icms\\Azure_Stack_HCI\\UpdateService\\784334093\\discussion.md (307 KB)\n[OUTPUT:rca.md] E:\\icms\\Azure_Stack_HCI\\UpdateService\\784334093\\rca.md (312 KB)\n[OUTPUT:metadata.md] E:\\icms\\Azure_Stack_HCI\\UpdateService\\784334093\\metadata.md (1 KB)\n[OUTPUT:ai_summary.md]","ai.success":true,"ai.model":"claude-sonnet-4.6","ai.durationMs":88560,"ai.inputTokens":206889,"ai.outputTokens":2883,"incidentFolder":"E:\\icms\\Azure_Stack_HCI\\UpdateService\\784334093","summary.md":"E:\\icms\\Azure_Stack_HCI\\UpdateService\\784334093\\summary.md (4 KB)","discussion.md":"E:\\icms\\Azure_Stack_HCI\\UpdateService\\784334093\\discussion.md (307 KB)","rca.md":"E:\\icms\\Azure_Stack_HCI\\UpdateService\\784334093\\rca.md (312 KB)","metadata.md":"E:\\icms\\Azure_Stack_HCI\\UpdateService\\784334093\\metadata.md (1 KB)"},"outputData":{"incidentFolder":"E:\\icms\\Azure_Stack_HCI\\UpdateService\\784334093"},"globalVariables":{"maxQueryScore":0,"body.timestamp":"2026-04-25T21:08:50.618Z","codeIssueFile":"","agentFolder":"E:\\work\\hub\\docs\\wiki","__webhookBody":"{\n  \u0022incidentId\u0022: 784334093,\n  \u0022serviceName\u0022: \u0022\u0022,\n  \u0022teamName\u0022: \u0022\u0022,\n  \u0022timestamp\u0022: \u00222026-04-25T21:08:50.618Z\u0022\n}","repoMdFile":"E:\\work\\hub\\docs\\wiki\\repos.md","body.incidentId":784334093,"rcaFile":"","metadataFile":"","body.serviceName":"","discussionFile":"","mitigationStepsFile":"","body.teamName":"","rootRepoFolder":"E:\\work","incidentId":0,"queryLoopCount":0,"applicableTsgFile":"","incidentFolder":"E:\\icms\\Azure_Stack_HCI\\UpdateService\\784334093","etwEventsFile":"","summaryFile.md":"","issueListFile":""}}}
