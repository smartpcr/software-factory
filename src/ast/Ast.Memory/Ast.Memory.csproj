<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>Ast.Memory</RootNamespace>
    <AssemblyName>Ast.Memory</AssemblyName>
    <Description>Agent memory layer for the code knowledge hypergraph.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="System.Data.SQLite.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ast.Core\Ast.Core.csproj" />
    <ProjectReference Include="..\Ast.GraphDb\Ast.GraphDb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ast.Memory.Tests" />
    <InternalsVisibleTo Include="Ast.Memory.UnitTests" />
    <InternalsVisibleTo Include="Ast.Memory.IntegrationTests" />
  </ItemGroup>

</Project>