{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Forge": {
    "Db": {
      "Folder": "E:\\forge",
      "_Path_legacy_comment": "Forge:Db:Path is legacy. When set it takes precedence and the control DB lives at that exact path. Prefer Forge:Db:Folder for new configs."
    },
    "Stories": {
      "SpawnDriveInline": false
    },
    "BackendPolicy": {
      "Canonical": "copilot",
      "CanonicalInvokeMode": "sdk",
      "AllowedBackends": [ "copilot" ],
      "AllowedInvokeModes": [ "sdk", "cli" ]
    },
    "Compaction": {
      "ContextWindowRatio": 0.5
    }
  }
}
