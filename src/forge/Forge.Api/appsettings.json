{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Forge": {
    "Db": {
      "Path": "E:\\forge\\forge.db"
    },
    "Stories": {
      "SpawnDriveInline": false
    },
    "BackendPolicy": {
      "Canonical": "copilot",
      "CanonicalInvokeMode": "sdk",
      "AllowedBackends": [ "copilot" ],
      "AllowedInvokeModes": [ "sdk", "cli" ]
    },
    "Compaction": {
      "ContextWindowRatio": 0.5
    }
  }
}
