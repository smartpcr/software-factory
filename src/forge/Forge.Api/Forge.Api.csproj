<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Forge.Api</RootNamespace>
    <AssemblyName>Forge.Api</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Forge.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <!-- Phase 9 — MSAL interactive sign-in (system browser), DPAPI-backed token cache. -->
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" />
    <!-- Phase 11.5b — GitHub Copilot SDK for the in-process streaming runner. -->
    <PackageReference Include="GitHub.Copilot.SDK" />
    <!-- Phase 46 — workstreams.yaml decomposition artefact + plan front-matter parser. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <!-- Phase 11.2 — model registry seed. The Web SDK auto-includes the JSON;
       we just promote it from "do nothing" to "copy to output" so operators
       can edit the file in place after publish without a recompile. -->
  <ItemGroup>
    <Content Update="Agents\Models\models.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Phase 24 Q24.13 — copy the comment-response system template (and any
       sibling system-preamble templates) into the build output so the runtime
       can load them at agents/templates/*.md without a publish step. The
       template files live in the repo root's agents/templates/ folder; the
       Link metadata flattens them into agents/templates/ relative to the
       output directory. Operators can replace the deployed file in place. -->
  <ItemGroup>
    <Content Include="..\..\..\agents\templates\*.md" LinkBase="agents\templates">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
