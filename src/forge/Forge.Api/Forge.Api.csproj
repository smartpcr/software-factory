<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Forge.Api</RootNamespace>
    <AssemblyName>Forge.Api</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Forge.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Chat bridge transport + channel map + inbound pump (reusable lib). -->
    <ProjectReference Include="..\..\Common.Chat\Common.Chat.csproj" />
    <ProjectReference Include="..\..\Common.Chat.Telegram\Common.Chat.Telegram.csproj" />
    <ProjectReference Include="..\..\Common.Chat.Slack\Common.Chat.Slack.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <!-- Phase 9 — MSAL interactive sign-in (system browser), DPAPI-backed token cache. -->
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" />
    <!-- Phase 95 — DPAPI-encrypted chat-bridge bot-token blob (%LOCALAPPDATA%\Forge\chat-token.bin). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <!-- Phase 11.5b — GitHub Copilot SDK for the in-process streaming runner.
         1.0.34 (Forge only; other projects stay on the central beta): its build
         downloads the matching Copilot runtime (CLI 1.0.112, protocol 3) into
         runtimes\win-x64\native\, and CopilotServerManager runs that copy, so a
         self-updated system copilot.exe (1.0.115 speaks protocol 4) can no longer
         break the SDK handshake. -->
    <PackageReference Include="GitHub.Copilot.SDK" VersionOverride="1.0.34" />
    <!-- Phase 46 — workstreams.yaml decomposition artefact + plan front-matter parser. -->
    <PackageReference Include="YamlDotNet" />
    <!-- Phase 59 Stage C — Roslyn-in-process impacted-test resolver
         for C# (xUnit / MSTest / NUnit). Locator must run via
         MSBuildLocator.RegisterDefaults() at Program.cs startup
         before any MSBuildWorkspace.Create() call.
         2026-05-26 — ALL Microsoft.CodeAnalysis.* pinned directly to 5.3.0
         here. Microsoft.EntityFrameworkCore.Design 8.0.10 transitively pulls
         CSharp + CSharp.Workspaces 4.5.0; pinning only Common/Workspaces.MSBuild
         (the prior fix) left CSharp + CSharp.Workspaces at 4.5.0, so at runtime
         the 4.5.0 CSharp.Workspaces bound against 5.3.0 Workspaces and threw
         ReflectionTypeLoadException inside MSBuildWorkspace — silently breaking
         the Roslyn impacted-test provider for every repo (verified via
         RoslynNet472DiagTests). Pinning the CSharp pair directly forces 5.3.0
         everywhere (EF Design's Roslyn use is design-time only — Forge uses
         hand-written migrations — so the runtime is unaffected). -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.Build.Locator" />
  </ItemGroup>

  <!-- Phase 11.2 — model registry seed. The Web SDK auto-includes the JSON;
       we just promote it from "do nothing" to "copy to output" so operators
       can edit the file in place after publish without a recompile. -->
  <ItemGroup>
    <Content Update="Agents\Models\models.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Phase 24 Q24.13 — copy the comment-response system template (and any
       sibling system-preamble templates) into the build output so the runtime
       can load them at agents/templates/*.md without a publish step. The
       template files live in the repo root's agents/templates/ folder; the
       Link metadata flattens them into agents/templates/ relative to the
       output directory. Operators can replace the deployed file in place. -->
  <ItemGroup>
    <Content Include="..\..\..\agents\templates\*.md" LinkBase="agents\templates">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- ralph-loop skill read at runtime (RalphLoopPrompt) and injected into a
         stalled generator's prompt; the repo copy is the single source of truth. -->
    <Content Include="..\..\..\.claude\skills\ralph-loop\SKILL.md" Link=".claude\skills\ralph-loop\SKILL.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
